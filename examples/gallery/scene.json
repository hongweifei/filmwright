{
  "$schema": "filmwright/scene-v0",
  "shots": [
    {"type": "title", "at": 1, "kicker": "TEMPLATE GALLERY", "title": "gallery",
     "sub": "17 类模板镜头", "en": "scene.json, zero shot code"},

    {"type": "bullets", "at": "S01", "heading": "bullets · 要点列表",
     "items": [
       {"t": "每行一个主张", "d": "t 主文案"},
       {"t": "右侧配说明", "d": "d 次要文字"},
       {"t": "落位后保持呼吸", "d": "静止会被画质自检判停"}
     ]},

    {"type": "steps", "at": "S02", "heading": "steps · 编号步骤",
     "steps": [
       {"t": "写解说词", "d": "narration.txt，一行一句"},
       {"t": "跑 tts", "d": "配音与时间轴一起生成"},
       {"t": "配画面", "d": "scene.json 的 at 对齐句 id"}
     ]},

    {"type": "table", "at": "S03", "heading": "table · 表格",
     "columns": ["类型", "容量", "适合"],
     "rows": [
       ["bullets", "≤ 6 行", "主张 + 说明"],
       ["table", "4 列 × 8 行", "多维对比"],
       ["chips", "≤ 12 个", "关键词平铺"]
     ]},

    {"type": "quote", "at": "S04",
     "text": "质量下限不该依赖模型的自觉，而该由引擎保证。", "who": "filmwright",
     "effects": [{"type": "grade", "look": "filmic", "amount": 0.5},
                 {"type": "vignette", "amount": 0.35}],
     "animate": {"alpha": [{"frame": 1, "v": 0}, {"frame": 14, "v": 1, "ease": "out3"}]}},

    {"type": "stat", "at": "S05", "value": 17, "unit": "类",
     "label": "模板镜头", "label2": "title → bars，全部内建节奏"},

    {"type": "flow", "at": "S06", "heading": "flow · 流程盒",
     "boxes": [
       {"label": "narration.txt", "sub": "内容"},
       {"label": "tts", "sub": "时间轴"},
       {"label": "scene.json", "sub": "节拍"},
       {"label": "mp4", "sub": "成片"}
     ]},

    {"type": "code", "at": "S07", "heading": "code · 代码块",
     "lines": [
       {"text": "// 一个 bullets 镜头长这样："},
       "{\"type\": \"bullets\", \"at\": \"S01\",",
       " \"items\": [{\"t\": \"主张\", \"d\": \"说明\"}]}",
       {"text": "// 入场、呼吸、配色：模板包了", "mark": "hl"}
     ]},

    {"type": "terminal", "at": "S08", "heading": "terminal · 终端窗口", "title": "zsh",
     "lines": [
       {"text": "$ filmwright check --project gallery --json", "color": "#E9F0FA"},
       {"text": "{ \"ok\": true, \"command\": \"check\" }", "color": "#35D07F"},
       {"text": "$ filmwright all --project gallery --shards 3", "color": "#E9F0FA"},
       {"text": "gallery/renders/gallery.mp4  46.30s", "color": "#8B99B4"}
     ]},

    {"type": "chips", "at": "S09", "heading": "chips · 关键词",
     "items": ["逐帧纯函数", "分片并行", "无头 Chrome", "sRGB 钉死", "十道自检", "像素回归", "MCP", "scene.json"]},

    {"type": "bars", "at": "S10", "heading": "bars · 条形图（每帧耗时）", "unit": "ms",
     "items": [
       {"v": 81, "label": "Chrome"},
       {"v": 84, "label": "Edge"},
       {"v": 97, "label": "Chromium"},
       {"v": 120, "label": "旧管线"}
     ]},

    {"type": "image", "at": "S11", "asset": "filmstrip",
     "heading": "image · 图片素材", "note": "boot 加载完才开画：不会有空白帧"},

    {"type": "layers", "at": "S12", "layers": [
      {"content": {"type": "compare", "heading": "layers · 同一镜头里并发多层",
        "left": {"title": "生成镜头代码", "items": ["自由度最高", "质量靠模型自觉", "难以为继的风格"]},
        "right": {"title": "填场景规格", "items": ["秒级校验", "节奏由模板保证", "改词不用改帧号"]}},
       "z": 0, "transform": {"y": -34, "scale": 0.82}},
      {"content": {"type": "chips", "items": ["z 序", "时间窗 from/to", "各自的 transform", "各自的 animate"]},
       "z": 1, "from": 40, "to": 220,
       "transform": {"y": 246, "scale": 0.66},
       "animate": {"alpha": [{"frame": 1, "v": 0}, {"frame": 14, "v": 1, "ease": "out3"}]},
       "effects": [{"type": "glow", "intensity": 0.3, "threshold": 0.75}]}
     ]}
  ]
}
