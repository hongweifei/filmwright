{
  "name": "filmwright",
  "version": "0.1.0",
  "description": "专为 AI 自动化视频制作设计的逐帧渲染框架：Canvas 2D 上第 N 帧只是 N 的函数；scene.json 声明式镜头 + 模板节奏；Chrome + CDP 逐帧截图 → ffmpeg；十道自检与 MCP 服务器给 agent 用",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "video",
    "canvas",
    "explainer",
    "animation",
    "ffmpeg",
    "chrome-devtools-protocol",
    "chinese",
    "ai",
    "mcp",
    "text-to-video",
    "declarative"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hongweifei/filmwright.git"
  },
  "homepage": "https://github.com/hongweifei/filmwright#readme",
  "bugs": {
    "url": "https://github.com/hongweifei/filmwright/issues"
  },
  "bin": {
    "filmwright": "bin/filmwright.mjs"
  },
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\" && npm run test:py",
    "test:js": "node --test \"tests/**/*.test.mjs\"",
    "test:py": "node tools/run-python-tests.mjs",
    "coverage": "node --test --experimental-test-coverage \"tests/**/*.test.mjs\"",
    "check": "node bin/filmwright.mjs check --project examples/minimal",
    "render": "node bin/filmwright.mjs render --project examples/minimal --shards 3",
    "all": "node bin/filmwright.mjs all --project examples/minimal --shards 3",
    "regression:capture": "node tools/regression.mjs capture --project examples/minimal",
    "regression:verify": "node tools/regression.mjs verify --project examples/minimal",
    "verify:readme": "node tools/verify-readme.mjs",
    "verify:reuse": "node tools/verify-reuse.mjs",
    "verify:assets": "node tools/verify-assets.mjs",
    "verify:preview": "node tools/verify-preview.mjs",
    "verify:tts": "node tools/verify-tts.mjs",
    "verify:encoding": "node tools/verify-encoding.mjs ."
  },
  "files": [
    "bin",
    "src",
    "docs",
    "index.html",
    "README.md",
    "LIMITATIONS.md",
    "LICENSE",
    "!src/**/__pycache__",
    "!docs/design/**"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "three": ">=0.180.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "three": "^0.186.1"
  }
}
