{
  "name": "filmwright",
  "version": "0.1.0",
  "description": "在 Canvas 2D 上逐帧绘制的中文说明片渲染库：Chrome + CDP 逐帧截图 -> ffmpeg",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "video",
    "canvas",
    "explainer",
    "animation",
    "ffmpeg",
    "chrome-devtools-protocol",
    "chinese"
  ],
  "bin": {
    "filmwright": "bin/filmwright.mjs"
  },
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check": "node bin/filmwright.mjs check --project examples/minimal",
    "render": "node bin/filmwright.mjs render --project examples/minimal --shards 3",
    "all": "node bin/filmwright.mjs all --project examples/minimal --shards 3",
    "regression:capture": "node tools/regression.mjs capture --project examples/minimal",
    "regression:verify": "node tools/regression.mjs verify --project examples/minimal",
    "verify:readme": "node tools/verify-readme.mjs",
    "verify:reuse": "node tools/verify-reuse.mjs",
    "verify:assets": "node tools/verify-assets.mjs",
    "verify:preview": "node tools/verify-preview.mjs"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "index.html",
    "README.md",
    "LIMITATIONS.md",
    "LICENSE"
  ]
}
